Necessary items inside every class (methods)
Null constructor():
class Calculator {
    // Attributes
    private int num1;
    private int num2;
    Calculator() {
        num1 = 0;
        num2 = 0;
        count++;
    }
Prametrize constructor():

Calculator(int num1, int num2) {
        this.num1 = num1;
        this.num2 = num2;
        count++;
    }

Copy constructor():

 Calculator(Calculator c) {
        this.num1 = c.num1;
        this.num2 = c.num2;
        count++;
    }
Object Count():

 public static int getObjectCount() {
        return count;
    }

Setters():

public void setNum1(int num1) {
        this.num1 = num1;
    }

    public void setNum2(int num2) {
        this.num2 = num2;
    }
Getters():

public int getNum1() {
        return num1;
    }

    public int getNum2() {
        return num2;
    }

Display():

public void display() {
        System.out.println("First Number : " + num1);
        System.out.println("Second Number : " + num2);
}

twoString method():

Override
    public String toString() {
        return "Calculator [num1=" + num1 + ", num2=" + num2 + "]";
}
